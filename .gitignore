## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/
.vscode/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Rider (if used)
.idea/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
project.assets.json
*.runtimeconfig.dev.json

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Publish output
publish/
*.publishproj

# Azure
*.azurePubxml
*.publishsettings

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Generated files
Generated_Code/

# Backup & report files
*.bak
*.tmp
*.temp